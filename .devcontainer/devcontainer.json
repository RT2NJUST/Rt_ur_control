{
  "name": "rt_develop",
  "image": "yc-dlan/rt_ur_container:latest",
  "customizations": {
		"vscode": {
			"extensions": [
				// C++ language support
				"llvm-vs-code-extensions.vscode-clangd",
				// Python language support
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				// CMake language support
				"twxs.cmake",
				// Code spell checking
				"streetsidesoftware.code-spell-checker",
				// Git enhancements
				"mhutchie.git-graph"
			]
		}
	},
	"runArgs": [
    "--network=host",
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  }
}